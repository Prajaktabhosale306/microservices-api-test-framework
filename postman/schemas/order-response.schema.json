{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderResponse",
  "type": "object",
  "required": ["orderId", "userId", "items", "totalAmount", "status", "createdAt"],
  "properties": {
    "orderId": {
      "type": "string",
      "pattern": "^ord_[a-f0-9]{8}$"
    },
    "userId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "totalAmount": {
      "type": "number",
      "minimum": 0.01
    },
    "status": {
      "type": "string",
      "enum": ["PROCESSING", "CONFIRMED", "CANCELLED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    }
  },
  "additionalProperties": false
}